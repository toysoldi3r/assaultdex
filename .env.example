# AssaultDex environment variables (Phase 1)
#
# Phase 1 runs on SQLite through Prisma so the slice is runnable without an
# external database server. Copy this file to `.env` before running migrations,
# the seed, or the app:
#
#   cp .env.example .env
#
# Production target is PostgreSQL (see docs/ARCHITECTURE.md, Risks). To switch,
# set DATABASE_URL to a postgres:// URL and change the datasource provider in
# prisma/schema.prisma to "postgresql".

# SQLite (development / CI). Path is relative to the prisma/ directory.
DATABASE_URL="file:./dev.db"
