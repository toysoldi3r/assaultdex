# eslint-config-next relies on plugins being resolvable from the project root.
# pnpm's isolated node_modules hides them, so hoist eslint packages.
public-hoist-pattern[]=*eslint-plugin*
public-hoist-pattern[]=@next/eslint-plugin-next
public-hoist-pattern[]=@typescript-eslint/*
public-hoist-pattern[]=@rushstack/eslint-patch

# Windows MAX_PATH (260 char) safety. pnpm's isolated store nests packages
# under long, peer-hashed folder names (e.g. .pnpm/@prisma+client@6.19.3_prisma@
# 6.19.3_typescript@5.7.3__typescript@5.7.3/node_modules/...), which can push
# paths past Windows' limit and break installs, builds, and even deleting the
# folder. Truncating the virtual-store dir names keeps paths short without
# changing the install layout or dependency resolution. (pnpm >= 9.1)
virtual-store-dir-max-length=60
