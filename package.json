{
  "name": "assaultdex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "generate:fixtures": "tsx scripts/generateFixtures.ts && tsx scripts/genDexNumbers.ts",
    "refresh:usage": "tsx scripts/refreshUsage.ts",
    "refresh:pokedex": "tsx scripts/refreshPokedex.ts",
    "refresh:tournaments": "tsx scripts/refreshTournaments.ts",
    "refresh:item-icons": "tsx scripts/refreshItemIcons.ts",
    "refresh:pokemon-art": "tsx scripts/refreshPokemonArt.ts",
    "db:generate:pg": "prisma generate --schema prisma/schema.postgres.prisma",
    "db:push:pg": "prisma db push --schema prisma/schema.postgres.prisma",
    "deploy:setup:pg": "prisma generate --schema prisma/schema.postgres.prisma && prisma db push --schema prisma/schema.postgres.prisma && tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "refresh:source-icons": "tsx scripts/refreshSourceIcons.ts"
  },
  "packageManager": "pnpm@9.15.9",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@pkmn/data": "^0.10.11",
    "@pkmn/img": "^0.3.4",
    "@prisma/client": "6.19.3",
    "next": "15.5.23",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@pkmn/dex": "^0.10.11",
    "@types/node": "22.10.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.18.0",
    "eslint-config-next": "15.5.23",
    "postcss": "8.5.1",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.0.4"
  }
}
